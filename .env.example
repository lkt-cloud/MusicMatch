# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings → API). These two are safe to expose in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Stripe and the Supabase service-role key are NOT set here. They go into
# Supabase Edge Function secrets (see SETUP.md), never into the website.
